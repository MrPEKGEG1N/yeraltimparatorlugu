# Northflank runtime — servis → Environment → Runtime variables
# Secret olarak isaretleyin: JWT_SECRET, SUPABASE_SERVICE_ROLE_KEY

PERSISTENT_DATA_PATH=/data
NODE_ENV=production
PORT=3000
ADMIN_USERNAME=mrpekgeg1n

# Railway'de ayarli degildi; ayni varsayilan kullanildi (oturumlar yeniden giris gerekebilir)
JWT_SECRET=yeralti-dev-gizli-anahtar-degistir

# Railway'den aktarildi — Northflank panelinde Secret olarak ekleyin
SUPABASE_URL=https://pzkafimfxuspoeybrywx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<railway-variables-dan-kopyala>

# Deploy sonrasi Northflank public URL ile guncelleyin
PUBLIC_BASE_URL=https://<servis-adiniz>.code.run
